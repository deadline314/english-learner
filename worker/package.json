{
  "name": "english-learner-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "npm run build:frontend --workspace=frontend && wrangler deploy",
    "db:migrate": "wrangler d1 execute english-learner-db --local --file=src/db/schema.sql",
    "db:seed": "wrangler d1 execute english-learner-db --local --file=src/db/seed.sql",
    "db:migrate:remote": "wrangler d1 execute english-learner-db --remote --file=src/db/schema.sql",
    "db:seed:remote": "wrangler d1 execute english-learner-db --remote --file=src/db/seed.sql"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "jose": "^5.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "wrangler": "^3.60.0",
    "typescript": "^5.5.0"
  }
}
